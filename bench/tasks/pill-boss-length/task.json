    { "name": "boss1-body-kept-x2.4",     "p": [2.4, 12.5, 3.5],  "inside": true },
    { "name": "boss1-height-kept-z4.8",   "p": [0, 12.5, 4.8],    "inside": true },
    { "name": "boss1-width-kept-y13.4",   "p": [0, 13.4, 3.5],    "inside": true },
    { "name": "boss1-width-unchanged-y13.6", "p": [0, 13.6, 3.5], "inside": false },
    { "name": "boss2-centre-kept",        "p": [-10.825, -6.25, 3.5], "inside": true },
    { "name": "boss3-centre-kept",        "p": [10.825, -6.25, 3.5],  "inside": true },
    { "name": "ring-body",                "p": [0, 12.5, 0],      "inside": true },
    { "name": "ring-bore",                "p": [0, 5, 0],         "inside": false }
  ]
