    { "name": "boss-keeps-full-radius-at-the-top",  "p": [3.9, 0, 9.5], "inside": true },
    { "name": "boss-top-edge-not-tapered-off-axis", "p": [0, 3.9, 9.5], "inside": true },
    { "name": "boss-keeps-full-radius-mid-height",  "p": [3.9, 0, 7],   "inside": true },
    { "name": "boss-not-fattened",                  "p": [4.2, 0, 7],   "inside": false },
    { "name": "no-fillet-at-the-boss-root",         "p": [4.3, 0, 4.2], "inside": false },
    { "name": "no-fillet-at-the-root-off-axis",     "p": [0, -4.2, 4.2], "inside": false },
    { "name": "boss-root-still-solid",              "p": [0, 0, 4.5],   "inside": true },
    { "name": "plate-top-face-kept",                "p": [12, 12, 3.8], "inside": true },
