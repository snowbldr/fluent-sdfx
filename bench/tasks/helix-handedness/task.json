{
  "name": "helix-handedness",
  "category": "orientation",
  "tags": ["handedness", "helix", "mirror-invisible-to-bbox"],
  "mode": "build",
  "source": "mcweed helical airway ribs: handedness is invisible to every check short of looking at the part - bbox, height, volume and turn count are identical for a left-hand and a right-hand helix.",
  "summary": "Single-start right-hand helical rib on an 8 mm core, 12 mm pitch, 2 turns. shape.SweepHelix is RIGHT-handed as built (probed, not assumed): angle advances counter-clockwise seen from +Z as z rises, and the swept solid is centred on z = 0. The asfailed mirrors it (MirrorXZ) into a left-hand rib, which is bbox-identical and only shows up in probes along the rib path.",
  "expects_question": false,
  "align": "center",
  "grid": 150,
  "pass": { "iou_min": 0.99, "max_dev_mm": 0.3, "extra_max": 0.02 },
  "probes": [
    { "name": "rib-starts-on-plus-x-at-z0",        "p": [8.5, 0, 0],     "inside": true  },
    { "name": "rib-quarter-turn-ccw-at-z3",        "p": [0, 8.5, 3],     "inside": true  },
    { "name": "rib-three-quarter-turn-at-z9",      "p": [0, -8.5, 9],    "inside": true  },
    { "name": "rib-quarter-turn-below-at-z-3",     "p": [0, -8.5, -3],   "inside": true  },
    { "name": "rib-three-quarter-below-at-z-9",    "p": [0, 8.5, -9],    "inside": true  },
    { "name": "no-left-hand-rib-at-z3",            "p": [0, -8.5, 3],    "inside": false },
    { "name": "no-left-hand-rib-at-z9",            "p": [0, 8.5, 9],     "inside": false },
    { "name": "no-left-hand-rib-at-z-3",           "p": [0, 8.5, -3],    "inside": false },
    { "name": "rib-half-turn-at-z6-either-hand",   "p": [-8.5, 0, 6],    "inside": true  },
    { "name": "gap-between-turns-on-plus-x-at-z6", "p": [8.5, 0, 6],     "inside": false },
    { "name": "core-solid-on-axis",                "p": [0, 0, 0],       "inside": true  },
    { "name": "core-surface-solid-r7",             "p": [7, 0, 5],       "inside": true  },
    { "name": "clear-of-rib-crest-r9.6",           "p": [9.6, 0, 0],     "inside": false },
    { "name": "core-full-height-z11.5",            "p": [4, 0, 11.5],    "inside": true  },
    { "name": "core-ends-at-z12.5",                "p": [4, 0, 12.5],    "inside": false }
  ]
}
